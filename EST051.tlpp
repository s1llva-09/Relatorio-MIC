#Include "TOTVS.ch"
#Include "TopConn.ch"
#Include "tlpp-core.th"

/*/{Protheus.doc} RelatorioMIC
    Movimentos Internos Custeados (MIC).

    Query e colunas vem do EST033; a forma de rodar (sem tela, com envio
    por e-mail no agendamento) vem do EST051.

    @author Pablo Junior (pejunior)
    @since 27/08/2026
/*/
User function RelatorioMIC(lAuto, cDe, cAte, cLocDe, cLocAte) as character

    Local cRet     := "" as character
    Local cQuery   := "" as character
    Local cAlias   := "" as character
    Local cArquivo := "" as character
    Local aDados   := {} as array

    Default lAuto   := .F.
    Default cDe     := ""
    Default cAte    := ""
    Default cLocDe  := ""
    Default cLocAte := ""


    If Empty(cDe)
        cDe := DToS(dDataBase)
    EndIf
    If Empty(cAte)
        cAte := DToS(dDataBase)
    EndIf

    // "ZZZZZZZZZZ" fecha o BETWEEN pelo alto = todos os armazens.
    If Empty(cLocAte)
        cLocAte := "ZZZZZZZZZZ"
    EndIf

    cQuery := MontaQuery(cDe, cAte, cLocDe, cLocAte)
    
    cAlias := GetNextAlias()
    DbUseArea(.T., "TOPCONN", TCGenQry(,, cQuery), cAlias, .F., .T.)

    If (cAlias)->(Eof())
        (cAlias)->(DbCloseArea())
        Return cRet
    EndIf

    While !(cAlias)->(Eof())
        aAdd(aDados, LeLinha(cAlias))

        // IncProc so existe dentro de Processa()
        If !lAuto
            IncProc()
        EndIf

        (cAlias)->(dbSkip())
    EndDo

    (cAlias)->(DbCloseArea())

    cArquivo := MontaNome()

    If GeraExcel(cArquivo, aDados)
        cRet := cArquivo
    
        If lAuto
            EnviaEmail(cArquivo, cDe, cAte, Len(aDados))
        EndIf
    EndIf

Return cRet

// SQL do relatorio, baseado no EST033.
//
// SF5: o SQL de origem trazia "F4_TIPO" (campo da SF4) e nao ligava a
// SF5 ao movimento. Corrigido para F5_TIPO e F5_CODIGO = D3_TM; a
// descricao e F5_TEXTO. Nome fixo em SF5010 porque so existem
// SF5010/020/040/050 -- RetSqlName montaria SF5030 na empresa 03.
// O INNER descarta movimento com D3_TM fora da SF5, como no original.
Static Function MontaQuery(cDe as character, cAte as character, cLocDe as character, cLocAte as character) as character

    Local cQuery := "" as character

    cQuery := " SELECT D3_FILIAL, D3_LOCAL, D3_COD, D3_LOTECTL, D3_EMISSAO, "
    cQuery += "        D3_CC, D3_QUANT, D3_CUSTO1, D3_TM, D3_CF, D3_DOC, "
    cQuery += "        D3_NUMSEQ, D3_MAT, D3_USUARIO, D3_ORDEM, D3_OP, "
    cQuery += "        B1_TIPO, B1_GRUPO, B1_UM, B1_CONTA, B1_DESC, "
    cQuery += "        ISNULL(SRA.RA_NOME, '')  AS RANOMEFUN, "
    cQuery += "        ISNULL(SRA2.RA_NOME, '') AS RANOMESOLI, "
    cQuery += "        ISNULL(CP_MAT, '')       AS CPMAT, "
    cQuery += "        ISNULL(USR.USR_NOME, '') AS RANOMEATEN, "
    cQuery += "        ISNULL(F5_TEXTO, '')     AS TMDESCRI "
    cQuery += "   FROM " + RetSqlName("SD3") + " SD3 (NOLOCK) "

    cQuery += "  INNER JOIN " + RetSqlName("SB1") + " SB1 (NOLOCK) "
    cQuery += "     ON B1_FILIAL = '" + xFilial("SB1") + "' "
    cQuery += "    AND B1_COD = D3_COD "
    cQuery += "    AND SB1.D_E_L_E_T_ = '' "

    // LEFT porque nem todo movimento nasce de uma solicitacao
    cQuery += "   LEFT JOIN " + RetSqlName("SCP") + " SCP (NOLOCK) "
    cQuery += "     ON CP_FILIAL = '" + xFilial("SCP") + "' "
    cQuery += "    AND CP_NUM  = D3_NUMSA "
    cQuery += "    AND CP_ITEM = D3_ITEMSA "
    cQuery += "    AND SCP.D_E_L_E_T_ = '' "

    // Mesma tabela duas vezes: SRA = quem pediu, SRA2 = quem movimentou
    cQuery += "   LEFT JOIN " + RetSqlName("SRA") + " SRA (NOLOCK) "
    cQuery += "     ON SRA.RA_FILIAL = '" + xFilial("SRA") + "' "
    cQuery += "    AND SRA.RA_MAT = CP_MAT "
    cQuery += "    AND SRA.D_E_L_E_T_ = '' "

    cQuery += "   LEFT JOIN " + RetSqlName("SRA") + " SRA2 (NOLOCK) "
    cQuery += "     ON SRA2.RA_FILIAL = '" + xFilial("SRA") + "' "
    cQuery += "    AND SRA2.RA_MAT = D3_MAT "
    cQuery += "    AND SRA2.D_E_L_E_T_ = '' "

    cQuery += "   LEFT JOIN SYS_USR USR (NOLOCK) "
    cQuery += "     ON USR.USR_CODIGO = D3_USUARIO "
    cQuery += "    AND USR.D_E_L_E_T_ = '' "

    cQuery += "  INNER JOIN SF5010 SF5 (NOLOCK) "
    cQuery += "     ON F5_FILIAL = '    ' "
    cQuery += "    AND F5_CODIGO = D3_TM "
    cQuery += "    AND SF5.D_E_L_E_T_ = '' "

    cQuery += "  WHERE SD3.D_E_L_E_T_ = '' "
    cQuery += "    AND D3_FILIAL = '" + xFilial("SD3") + "' "
    cQuery += "    AND D3_ESTORNO <> 'S' "
    cQuery += "    AND D3_EMISSAO BETWEEN '" + cDe + "' AND '" + cAte + "' "
    cQuery += "    AND D3_LOCAL   BETWEEN '" + cLocDe + "' AND '" + cLocAte + "' "

    // F5_TIPO = 'P' e producao/apontamento, fora do escopo aqui
    cQuery += "    AND F5_TIPO <> 'P' "

    // DE4/RE4 sao transferencias: entram e saem pela mesma quantidade.
    cQuery += "    AND D3_CF <> 'DE4' "
    cQuery += "    AND D3_CF <> 'RE4' "

    cQuery += "  ORDER BY D3_EMISSAO, D3_LOCAL, D3_COD, D3_LOTECTL "

    // Sem ChangeQuery: a query ja esta na sintaxe nativa do MSSQL.

Return cQuery

// Le a linha na MESMA ordem das colunas de GeraExcel.
Static Function LeLinha(cAlias as character) as array

    Local aLinha := {} as array
    Local nQuant := (cAlias)->D3_QUANT as numeric
    Local nCusto := (cAlias)->D3_CUSTO1 as numeric
    Local nUnit  := 0 as numeric

    // O EST033 dividia direto e estourava divisao por zero em ajuste/estorno.
    If nQuant != 0
        nUnit := nCusto / nQuant
    EndIf

    AAdd(aLinha, Alltrim((cAlias)->D3_FILIAL))
    AAdd(aLinha, AllTrim((cAlias)->D3_LOCAL))
    AAdd(aLinha, AllTrim((cAlias)->D3_COD))
    AAdd(aLinha, AllTrim((cAlias)->B1_DESC))
    AAdd(aLinha, AllTrim((cAlias)->D3_LOTECTL))
    AAdd(aLinha, AllTrim((cAlias)->B1_TIPO))
    AAdd(aLinha, AllTrim((cAlias)->B1_GRUPO))
    AAdd(aLinha, AllTrim((cAlias)->B1_UM))

    AAdd(aLinha, DataBr((cAlias)->D3_EMISSAO))

    AAdd(aLinha, AllTrim((cAlias)->D3_CC))
    AAdd(aLinha, AllTrim((cAlias)->B1_CONTA))
    
    AAdd(aLinha, nQuant)
    AAdd(aLinha, nUnit)
    AAdd(aLinha, nCusto)

    AAdd(aLinha, AllTrim((cAlias)->D3_TM) + "/" + AllTrim((cAlias)->D3_CF))
    AAdd(aLinha, AllTrim((cAlias)->TMDESCRI))
    AAdd(aLinha, AllTrim((cAlias)->D3_DOC))
    AAdd(aLinha, AllTrim((cAlias)->D3_NUMSEQ))
    AAdd(aLinha, AllTrim((cAlias)->D3_ORDEM))
    AAdd(aLinha, AllTrim((cAlias)->D3_OP))
    AAdd(aLinha, AllTrim((cAlias)->RANOMESOLI))
    AAdd(aLinha, AllTrim((cAlias)->RANOMEFUN))
    AAdd(aLinha, AllTrim((cAlias)->RANOMEATEN))

Return aLinha

Static function DataBr(cData as character) as character

    Local cRet := "" as character

    cData := AllTrim(cData)

    If Len(cData) == 8
        cRet := SubStr(cData, 7, 2) + "/" + SubStr(cData, 5, 2) + "/" + SubStr(cData, 1, 4)
    EndIf

Return cRet


// O CpyS2T recebe a PASTA de destino, nao o arquivo: o nome vem da
// origem, entao o que o usuario digitar na janela e ignorado.
Static Function Baixar(cServidor as character) as character

    Local cEscolha := "" as character
    Local cDirCli  := "" as character
    Local nBarra   := 0 as numeric

    cEscolha := cGetFile("Planilha Excel (*.xlsx) |*.xlsx", ;
                         "Escolha a pasta de destino", , , .T., , .T.)

    If Empty(cEscolha)
        Return ""
    EndIf

    nBarra := RAt("\", cEscolha)

    If nBarra == 0
        Return ""
    EndIf

    cDirCli := SubStr(cEscolha, 1, nBarra)

    If !CpyS2T(cServidor, cDirCli)
        Return ""
    EndIf

Return cDirCli

// Caminho no servidor, relativo ao rootpath -- o CpyS2T nao aceita
// letra de drive na origem.
Static Function MontaNome() as character

    Local cDir := "\cachenosso\" as character

    If !ExistDir(cDir)
        MakeDir(cDir)
    EndIf

Return cDir + "MIC_" + CriaTrab(Nil, .F.) + ".xlsx"


// O EST033/EST051 abriam via MsExcel() (OLE), que nao funciona no
// SmartClient Web nem em job. Aqui so gravamos.
Static Function GeraExcel(cArquivo as character, aDados as array) as logical

    Local oExcel  := Nil
    Local cAba    := "MIC" as character
    Local cTabela := "Movimentos Internos Custeados" as character
    Local aCols   := {} as array
    Local nI      := 0 as numeric

    // {titulo, alinhamento (1=esq 2=centro 3=dir), formato (1=texto 2=num)}
    aCols := { ;
        {"Filial",          2, 1}, ;
        {"Armazem",         2, 1}, ;
        {"Produto",         1, 1}, ;
        {"Descricao",       1, 1}, ;
        {"Lote",            1, 1}, ;
        {"Tipo",            2, 1}, ;
        {"Grupo",           2, 1}, ;
        {"Und",             2, 1}, ;
        {"Dt Emissao",      2, 1}, ;
        {"Centro Custo",    1, 1}, ;
        {"Conta Contabil",  1, 1}, ;
        {"Qtd Movto",       3, 2}, ;
        {"Custo Unitario",  3, 2}, ;
        {"Custo Movto",     3, 2}, ;
        {"Tipo Movto",      2, 1}, ;
        {"Desc Tipo Movto", 1, 1}, ;
        {"Documento",       1, 1}, ;
        {"Sequencial",      1, 1}, ;
        {"Ordem Servico",   1, 1}, ;
        {"Ordem Producao",  1, 1}, ;
        {"Solicitante",     1, 1}, ;
        {"Funcionario",     1, 1}, ;
        {"Atendente",       1, 1}  }

    oExcel := FWMsExcelXlsx():New()
    oExcel:AddworkSheet(cAba)
    oExcel:AddTable(cAba, cTabela)

    For nI := 1 To Len(aCols)
        oExcel:AddColumn(cAba, cTabela, aCols[nI][1], aCols[nI][2], aCols[nI][3], .F.)
    Next nI

    For nI := 1 To Len(aDados)
        oExcel:AddRow(cAba, cTabela, aDados[nI])
    Next nI

    oExcel:Activate()
    oExcel:GetXMLFile(cArquivo)   // apesar do nome, grava xlsx tambem

Return File(cArquivo)

Static Function EnviaEmail(cArquivo as character, cDe as character, cAte as character, nLinhas as numeric)

    Local cFrom  := GetMV("MV_RELACNT") as character
    Local cTo    := AllTrim(GetMV("ZZ_MOVCUST")) as character
    Local cTitle := "" as character
    Local cBody  := "" as character

    cTitle := "[MIC] " + DToC(Date()) + " " + AllTrim(SM0->M0_CODIGO) + ;
              " " + AllTrim(SM0->M0_CODFIL) + " - Movimentos Internos Custeados"

    cBody := "<html><body style='font-family:verdana'>"
    cBody += "<p>Prezado(a), segue anexo o relatorio de Movimentos Internos Custeados.</p>"
    cBody += "<p><b>Empresa...: </b>" + AllTrim(SM0->M0_NOMECOM) + "</p>"
    cBody += "<p><b>Filial....: </b>" + AllTrim(SM0->M0_CODIGO) + " " + ;
             AllTrim(SM0->M0_CODFIL) + " - " + AllTrim(SM0->M0_FILIAL) + "</p>"
    cBody += "<p><b>Periodo...: </b>" + DataBr(cDe) + " a " + DataBr(cAte) + "</p>"
    cBody += "<p><b>Registros.: </b>" + cValToChar(nLinhas) + "</p>"
    cBody += "<p><b>Emitido em: </b>" + DToC(Date()) + " " + Time() + "</p>"
    cBody += "</body></html>"

    If Empty(cTo)
        ConOut("[MIC] ZZ_MOVCUST vazio -- sem destinatario, e-mail nao enviado")
        Return
    EndIf

    If Empty(cFrom)
        ConOut("[MIC] MV_RELACNT vazio -- sem remetente, e-mail nao enviado")
        Return
    EndIf

    If !File(cArquivo)
        ConOut("[MIC] anexo nao encontrado: " + cArquivo)
        Return
    EndIf

    ConOut("[MIC] enviando de " + cFrom + " para " + cTo)

    // from, to, CC, CCO, titulo, corpo, anexo, tipo(.T.=HTML), automatico.
    // Sao NOVE -- pular um desloca todos os seguintes.
    u_WFEmail(cFrom, cTo, "", "", cTitle, cBody, cArquivo, .T., .T.)

    ConOut("[MIC] u_WFEmail retornou sem erro")

Return

/*/{Protheus.doc} MICMENU
    Chamada pelo menu (SIGAEST). Pede os parametros, gera o arquivo e
    baixa na maquina do usuario. O e-mail e opcional na tela.
/*/
User function MICMENU()

    Local aPergs := {} as array
    Local aRet   := {} as array
    Local cArq   := "" as character
    Local cDe    := "" as character
    Local cAte   := "" as character
    Local cPasta := "" as character
    Local lEnvia := .F. as logical

    AAdd(aPergs, {1, "Emissao de",  dDataBase, "", "", "", "", 50, .F.})
    AAdd(aPergs, {1, "Emissao ate", dDataBase, "", "", "", "", 50, .F.})
    AAdd(aPergs, {1, "Armazem de",  Space(2), "@!", "", "", "", 50, .F.})
    AAdd(aPergs, {1, "Armazem ate", Space(2), "@!", "", "", "", 50, .F.})
    AAdd(aPergs, {2, "Enviar por e-mail", 2, {"Sim", "Nao"}, 60, "", .F.})

    // Os 3 ultimos argumentos desligam o cache: o ParamBox restaura a
    // ultima execucao POR POSICAO e erra quando a tela muda de estrutura.
    If !ParamBox(aPergs, "Movimentos Internos Custeados", @aRet, , , , , , , "MICPARAM", .F., .F.)
        Return
    EndIf

    cDe  := If(Empty(aRet[1]), "", DToS(aRet[1]))
    cAte := If(Empty(aRet[2]), "", DToS(aRet[2]))

    // O combo devolve ora o TEXTO, ora o INDICE, conforme a versao.
    If ValType(aRet[5]) == "N"
        lEnvia := (aRet[5] == 1)
    Else
        lEnvia := (Upper(AllTrim(aRet[5])) == "SIM")
    EndIf

    Processa({|| cArq := U_RelatorioMIC(lEnvia, cDe, cAte, ;
                                        AllTrim(aRet[3]), AllTrim(aRet[4])) }, ;
             "Gerando relatorio...")

    If Empty(cArq)
        MsgAlert("Nenhum movimento encontrado para os filtros informados.", "MIC")
        Return
    EndIf

    cPasta := Baixar(cArq)

    If !Empty(cPasta) .And. lEnvia
        MsgInfo("Relatorio salvo em:" + CRLF + cPasta + CRLF + "Enviado tambem por e-mail.", "MIC")
    ElseIf !Empty(cPasta)
        MsgInfo("Relatorio salvo em:" + CRLF + cPasta, "MIC")
    ElseIf lEnvia
        MsgInfo("Relatorio enviado por e-mail.", "MIC")
    EndIf

    // Apaga a copia do servidor mesmo se o usuario cancelou o download.
    FErase(cArq)

Return


/*/{Protheus.doc} MICAUTO
    Chamada pelo agendamento (QBG). Roda sem tela, no dia corrente, e
    envia o e-mail.

    Job puro precisa do RpcSetEnv, mas pelo QBG o ambiente JA existe e o
    RpcClearEnv derrubaria a sessao ("Alias does not exist SX2").
/*/
User Function MICAUTO()

    Local cArq    := "" as character
    Local lMontou := .F. as logical

    If Empty(cEmpAnt)
        RpcSetEnv("03", "5202")
        lMontou := .T.
    EndIf

    cArq := U_RelatorioMIC(.T.)

    If Empty(cArq)
        ConOut("[MIC] sem movimentos no periodo -- e-mail nao enviado")
    Else
        ConOut("[MIC] arquivo gerado e enviado: " + cArq)
    EndIf

    If lMontou
        RpcClearEnv()
    EndIf

Return

